# memory = no Docker/Postgres needed for local dev
# postgres = Supabase or Docker Postgres (required for data to survive API restarts)
DATABASE_DRIVER=memory
DATABASE_URL=postgresql://filetransfer:fSD2uQ6Jptz5nRcLg@localhost:5432/filetransfer

# Supabase — use Session pooler URI from Dashboard, OR direct URI + region (Windows needs pooler):
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_REGION=eu-north-1
# SUPABASE_POOLER_PREFIX=aws-1
# (API rewrites direct db.* URLs to the session pooler when SUPABASE_REGION is set; use aws-1 for newer projects)
REDIS_URL=redis://localhost:6379
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:5173
JWT_SECRET=dev-secret-change-in-production
# local = files on disk; r2 = Cloudflare R2 bucket
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

SUPPORT_INBOX=support@yourdomain.com
SUPPORT_FROM_EMAIL=Keira <onboarding@resend.dev>
# Transfer emails (recipient + optional sender copy); defaults to SUPPORT_FROM_EMAIL
TRANSFER_FROM_EMAIL=Keira <onboarding@resend.dev>
# Resend — replace re_xxxxxxxxx with your key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
RESEND_ACCOUNT_EMAIL=you@yourdomain.com
# Local only: redirect transfer emails here when using onboarding@resend.dev (sandbox)
RESEND_DEV_REDIRECT_TO=you@yourdomain.com
SUPPORT_WEBHOOK_URL=
