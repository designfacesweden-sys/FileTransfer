{
  "name": "filetransfer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @filetransfer/api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @filetransfer/api",
    "db:supabase": "node scripts/apply-supabase-schema.mjs",
    "provision": "node scripts/provision.mjs",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f"
  },
  "engines": {
    "node": ">=20"
  }
}
